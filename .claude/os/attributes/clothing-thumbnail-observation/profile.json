{
  "schemaVersion": "catalog-data-profile-v1",
  "id": "clothing-thumbnail-observation",
  "displayName": "의류 썸네일 관찰 GT",
  "attributeName": "썸네일 관찰 필드(사람·구도·얼굴·방향·노출)",
  "subjectName": "의류 썸네일",
  "outputRoot": ".claude/os/runs/clothing-thumbnail-observation",
  "source": {
    "repository": "../core-catalog-platfom"
  },
  "gtTask": {
    "schemaVersion": "gt-task-v1",
    "unit": "썸네일 한 장",
    "keyField": "id",
    "groupField": "goodsNo",
    "definitions": ".claude/os/attributes/clothing-thumbnail-observation/definitions.md",
    "gt": {
      "path": ".claude/gt/clothing-thumbnail-observation/gt.jsonl",
      "root": "project",
      "sourceField": "source",
      "fieldSourcesField": "fieldSources"
    },
    "authority": {
      "trusted": [
        "^USER_"
      ],
      "reference": [
        "^CLAUDE_HAND_LABEL"
      ]
    },
    "correctionSourcePrefix": "USER_GT_REVIEW",
    "fields": [
      {
        "id": "personPresence",
        "name": "사람이 있는가",
        "labels": [
          "PRESENT",
          "ABSENT"
        ],
        "labelNames": {
          "PRESENT": "사람 있음",
          "ABSENT": "사람 없음"
        },
        "fillMissing": true
      },
      {
        "id": "shotType",
        "name": "몸이 어디까지 보이나",
        "labels": [
          "MODEL_FULL_BODY",
          "MODEL_UPPER_BODY",
          "MODEL_LOWER_BODY",
          "MODEL_CLOSEUP",
          "NO_MODEL"
        ],
        "labelNames": {
          "MODEL_FULL_BODY": "전신",
          "MODEL_UPPER_BODY": "상반신",
          "MODEL_LOWER_BODY": "하반신",
          "MODEL_CLOSEUP": "부분 컷",
          "NO_MODEL": "사람 없음"
        },
        "legacy": {
          "MODEL_CROPPED": "MODEL_CLOSEUP",
          "DETAIL_CLOSEUP": "MODEL_CLOSEUP"
        },
        "fillMissing": true,
        "alternativesField": "shotTypeAlternatives"
      },
      {
        "id": "faceVisibility",
        "name": "얼굴이 보이나",
        "labels": [
          "VISIBLE",
          "HIDDEN",
          "NO_MODEL"
        ],
        "labelNames": {
          "VISIBLE": "얼굴 보임",
          "HIDDEN": "얼굴 잘림·가림",
          "NO_MODEL": "사람 없음"
        },
        "fillMissing": true
      },
      {
        "id": "productView",
        "name": "상품이 어느 쪽을 보이나",
        "labels": [
          "FRONT",
          "SIDE",
          "BACK",
          "UNKNOWN"
        ],
        "labelNames": {
          "FRONT": "앞",
          "SIDE": "옆",
          "BACK": "뒤",
          "UNKNOWN": "알 수 없음"
        },
        "legacy": {
          "OBLIQUE": "SIDE"
        },
        "fillMissing": true
      },
      {
        "id": "productVisibility",
        "name": "상품이 통째로 보이나",
        "labels": [
          "WHOLE",
          "CROPPED_OR_OCCLUDED"
        ],
        "labelNames": {
          "WHOLE": "통째로 보임",
          "CROPPED_OR_OCCLUDED": "잘림·가림"
        },
        "fillMissing": true
      }
    ],
    "constraints": [
      {
        "id": "ABSENT_HAS_NO_MODEL",
        "text": "사람이 없으면 구도와 얼굴은 «사람 없음»이어야 합니다",
        "when": {
          "personPresence": "ABSENT"
        },
        "require": {
          "shotType": [
            "NO_MODEL"
          ],
          "faceVisibility": [
            "NO_MODEL"
          ]
        }
      },
      {
        "id": "PRESENT_HAS_A_MODEL",
        "text": "사람이 있으면 구도와 얼굴이 «사람 없음»일 수 없습니다",
        "when": {
          "personPresence": "PRESENT"
        },
        "require": {
          "shotType": [
            "MODEL_FULL_BODY",
            "MODEL_UPPER_BODY",
            "MODEL_LOWER_BODY",
            "MODEL_CLOSEUP"
          ],
          "faceVisibility": [
            "VISIBLE",
            "HIDDEN"
          ]
        }
      }
    ],
    "images": {
      "path": "tool/image-gender/gt-harness/data/thumbnail-model-gender-gt-20260831.jsonl",
      "root": "source",
      "keyField": "id",
      "fileField": "localPath",
      "fileRoot": "source",
      "fileBase": "tool/image-gender/gt-harness",
      "idField": "id",
      "maxImages": 1,
      "contextFields": [
        "standardCategory"
      ]
    },
    "limit": 8,
    "columnNames": {
      "standardCategory": "표준 카테고리"
    }
  }
}
