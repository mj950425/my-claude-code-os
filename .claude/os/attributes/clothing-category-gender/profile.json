{
  "schemaVersion": "catalog-data-profile-v1",
  "id": "clothing-category-gender",
  "displayName": "의류 대상 고객 성별",
  "attributeName": "대상 고객 성별",
  "subjectName": "의류 상품",
  "outputRoot": ".claude/os/runs/clothing-category-gender",
  "source": {
    "repository": "../core-catalog-platfom"
  },
  "policyTask": {
    "schemaVersion": "policy-task-v1",
    "definitions": ".claude/os/attributes/clothing-category-gender/definitions.md",
    "fields": [
      {
        "id": "targetGender",
        "name": "대상 고객 성별",
        "valueCodes": {
          "남성": "MALE",
          "여성": "FEMALE",
          "공용": "UNISEX",
          "판단 불가": "UNDETERMINED"
        }
      }
    ],
    "promptDelivery": {
      "resource": "core/src/main/resources/prompts/image-gender/v1000/clothing.txt",
      "adapter": "core/src/main/java/com/musinsa/ccp/core/platform/gender/application/support/ClothingGenderDetailPrompt.java",
      "field": "targetGender",
      "root": "source",
      "adapterTargets": [
        {
          "name": "canonical-prompt-hash",
          "pattern": "(public static final String CANONICAL_SHA256\\s*=\\s*)\"[0-9a-f]{64}\";",
          "valueTemplate": "{sha256}"
        },
        {
          "name": "product-prompt-version",
          "pattern": "(public static final String VERSION\\s*=\\s*)[\\s\\S]*?;",
          "valueTemplate": "clothing-product-gender-v1000+policy-{hash12}"
        },
        {
          "name": "role-aware-judge-version",
          "pattern": "(public static final String ROLE_AWARE_JUDGE_VERSION\\s*=\\s*)[\\s\\S]*?;",
          "valueTemplate": "clothing-evidence-judge-scene-role-v16+policy-{hash12}"
        }
      ],
      "beginMarker": "<!-- BEGIN POLICY_RULES: clothing-category-gender/targetGender -->",
      "endMarker": "<!-- END POLICY_RULES: clothing-category-gender/targetGender -->"
    },
    "documentFormat": "policy-document-v2"
  },
  "gtTask": {
    "schemaVersion": "gt-task-v1",
    "unit": "상품",
    "keyField": "productKey",
    "groupField": "standardCategory",
    "titleField": "productName",
    "definitions": ".claude/os/attributes/clothing-category-gender/definitions.md",
    "gt": {
      "path": "tool/image-gender/gt-harness/data/clothing-product-gt-20260903.jsonl",
      "root": "source",
      "sourceField": "goldLabelSource",
      "upstream": {
        "kind": "sheet",
        "note": "D/O 검수 시트의 «최종 검수 GT» 열",
        "refresh": "refresh_product_gt_from_google_sheet.py가 시트에서 이 파일을 다시 만든다(개발자가 돌린다)",
        "acceptsEmpty": false,
        "mirrorFields": [
          "finalReviewLabel"
        ],
        "locatorFields": [
          "sourceSheet",
          "sheetRow",
          "sourceCell"
        ],
        "rowCheck": {
          "row": "sheetRow",
          "cell": "sourceCell",
          "sheet": "sourceSheet",
          "rowSheet": "9/1 의류/잡화/가방/스포츠"
        },
        "columns": {
          "targetGender": "최종 검수 GT"
        },
        "headerNames": {
          "productKey": "상품 키",
          "sourceSheet": "시트 탭",
          "sheetRow": "시트 행",
          "sourceCell": "시트 칸",
          "reviewer": "이름",
          "reason": "검수 근거"
        }
      },
      "supersededBy": {
        "glob": "*.provenance.json",
        "baseField": "baseGt",
        "markerSuffix": ".provenance.json"
      }
    },
    "authority": {
      "trusted": [
        "^FINAL_",
        "^USER_",
        "_MANUAL_REVIEW"
      ],
      "reference": [
        "FALLBACK"
      ]
    },
    "correctionSourcePrefix": "USER_GT_REVIEW",
    "fields": [
      {
        "id": "targetGender",
        "name": "대상 고객 성별",
        "gtField": "goldLabel",
        "fillMissing": false,
        "unknownLabel": "UNDETERMINED"
      }
    ],
    "images": {
      "path": ".claude/os/runs/clothing-category-gender/golden/clothing-image-index.jsonl",
      "root": "project",
      "keyField": "productKey",
      "joinField": "productKey",
      "listField": "images",
      "fileField": "file",
      "fileRoot": "output",
      "idField": "imageId",
      "roleField": "role",
      "roles": [
        "THUMBNAIL",
        "THUMBNAIL_EXTRA",
        "DETAIL_TILE"
      ],
      "maxImages": 16,
      "preTiledRoles": [
        "DETAIL_TILE"
      ],
      "preTiledRule": {
        "name": "ccp-batch-image-composer-tile-ranges",
        "version": "v2-band-then-seam",
        "by": "engine incr_collect.py (common/tile_rule)",
        "decoder": "harness-pillow"
      },
      "contextFields": [
        "standardCategory"
      ],
      "roleNames": {
        "THUMBNAIL": "대표 썸네일",
        "DETAIL_TILE": "상세 조각",
        "THUMBNAIL_EXTRA": "추가 썸네일"
      },
      "alwaysKeepRoles": [
        "THUMBNAIL",
        "THUMBNAIL_EXTRA"
      ]
    },
    "limit": 60,
    "evidence": {
      "textFields": [
        "productName"
      ]
    },
    "titleAsEvidence": true,
    "columnNames": {
      "standardCategory": "표준 카테고리",
      "productName": "상품명"
    },
    "linkField": "pdpUrl",
    "prerequisite": {
      "adapter": ".claude/os/attributes/clothing-category-gender/adapters/import_clothing_images.py",
      "note": "GT용 로컬 이미지 원본이 필요합니다. --source-index <로컬 JSONL 경로>로 가져온 뒤 다시 준비합니다. 색인의 productKey와 GT 상품 키를 대조하며, DB·API·정답은 변경하지 않습니다."
    }
  },
  "incremental": {
    "schemaVersion": "incr-source-v1",
    "note": "증분 검수의 새 데이터를 운영에서 모으는 법 — engine/scripts/incr_collect.py가 읽는다. 조회는 읽기 전용 mysql-query 스킬로",
    "platforms": [
      "MUSINSA",
      "EGOOCM"
    ],
    "categoryPrefix": "의류>",
    "key": "{platform}:{goodsNo}",
    "hosts": {
      "MUSINSA": "https://image.msscdn.net/thumbnails",
      "EGOOCM": "https://img.29cm.co.kr"
    },
    "pdp": {
      "MUSINSA": "https://www.musinsa.com/products/{goodsNo}",
      "EGOOCM": "https://www.29cm.co.kr/products/{goodsNo}"
    },
    "detail": true,
    "maxDetailImages": 0,
    "tileRule": {
      "name": "ccp-batch-image-composer-tile-ranges",
      "version": "v2-band-then-seam",
      "decoder": "java-imageio",
      "by": "core-catalog-platfom BatchImageComposer.tileRanges (prd 344ca53b) — 운영이 지금 자르는 규칙. 골든셋 색인의 preTiledRule은 옛 번호의 선언이라 새 상품에 쓰지 않는다"
    },
    "ledgerFallbackPlatforms": [
      "EGOOCM"
    ],
    "thumbnailSource": "ledger",
    "extraThumbnailRole": "THUMBNAIL_EXTRA",
    "productStatuses": [
      "ONSALE"
    ]
  }
}
